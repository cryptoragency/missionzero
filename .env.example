# Meta Model API key (the default provider, https://api.meta.ai/v1)
MODEL_API_KEY=
# Spending caps in dollars. MZ_CAP_USD stops one run (default 5). MZ_DAILY_CAP_USD adds up every run of the day on this
# machine (memory/spend.json); the day is the UTC day, so the daily cap resets at midnight UTC. Empty = no daily cap.
MZ_CAP_USD=5
MZ_DAILY_CAP_USD=5
# Model. Leave it commented to use the provider's default: muse-spark-1.3 on Meta, meta-models/muse-spark-open on Baseten,
# accounts/fireworks/models/muse-spark-open on Fireworks. The Participant Guide names meta-models/muse-spark-open-1026;
# our Baseten key refused it on 30 October 2026 and serves meta-models/muse-spark-open.
# MZ_MODEL=

# Optional: findings from any scanner's URL (npm run repair -- --from=URL, or set the URL here); the key goes as a Bearer token
MZ_SCANNER_URL=
MZ_SCANNER_KEY=
# The scanner probes only a host you proved you control: localhost, or a host that serves this token (16+ characters) at /.well-known/mission-zero.txt
MZ_OWNER_TOKEN=
# The page reader refuses local and private addresses (SSRF guard). MZ_ALLOW_LOCAL=1 lets it read this machine only
# (127.0.0.1, ::1, localhost), e.g. the demo site; the link-local and private networks stay refused.
# MZ_ALLOW_LOCAL=1

# Optional: open-weight Muse Spark on Baseten or Fireworks (or any OpenAI-compatible endpoint). The key follows the base URL;
# any other host, or a plain-http URL, is refused at the first call unless MZ_ALLOW_CUSTOM_BASE=1; it then gets
# MODEL_API_KEY (or MZ_MODEL_KEY), and a warning says where it goes.
# MZ_ALLOW_CUSTOM_BASE=1
# MZ_BASE_URL=https://inference.baseten.co/v1
BASETEN_API_KEY=
# MZ_BASE_URL=https://api.fireworks.ai/inference/v1
# FIREWORKS_API_KEY=
# Prices in dollars per million tokens (default 1.25 in, 4.25 out, 0.15 cached input). 0 is a valid price.
# MZ_PRICE_IN=
# MZ_PRICE_OUT=
# MZ_PRICE_CACHED=

# Optional: vision (--vision) needs Playwright; voice needs ffmpeg when the WAV is not mono 16-bit 16/24 kHz
# MZ_PLAYWRIGHT=playwright
# MZ_FFMPEG=ffmpeg
# Optional: the community page (web/) reads x-forwarded-for only behind your own proxy
# MZ_TRUST_PROXY=1
