MODEL_API_KEY=
MZ_CAP_USD=5
MZ_DAILY_CAP_USD=5
MZ_MODEL=muse-spark-1.3
# Optional: findings from any scanner's URL (npm run repair -- --from=URL, or set the URL here); the key goes as a Bearer token
MZ_SCANNER_URL=
MZ_SCANNER_KEY=
# Optional: open-weight Muse Spark on Baseten (or any OpenAI-compatible endpoint), with that provider's prices per million tokens
# MZ_BASE_URL=https://inference.baseten.co/v1
# MZ_MODEL=meta-models/muse-spark-open-1026   # the hackathon slug of the Participant Guide; default: meta-models/muse-spark-open (the one our account lists)
# MZ_PRICE_IN=
# MZ_PRICE_OUT=
# Optional: vision (--vision) needs Playwright; voice needs ffmpeg when the WAV is not mono 16-bit 16/24 kHz
# MZ_PLAYWRIGHT=playwright
# MZ_FFMPEG=ffmpeg
